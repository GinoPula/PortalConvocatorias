# Copiar este archivo como .env en el servidor (junto a docker-compose.yml) y completar.

# Contrasena para el usuario de PostgreSQL del contenedor db
DB_PASSWORD=cambia-esta-contrasena

# Clave secreta para firmar las cookies de sesion (generar una nueva, no reutilizar la de dev)
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

# Origen exacto (protocolo + IP/dominio + puerto) desde donde el frontend hara las peticiones
CORS_ORIGINS=http://IP_DEL_SERVIDOR:86

# URL base que el frontend usara para llamar a la API
API_BASE=http://IP_DEL_SERVIDOR:8086

# Opcional: API key de OpenAI si se usa el analisis de CV con IA
OPENAI_API_KEY=

# Google reCAPTCHA v2 (casilla "No soy un robot") en el login. Crear el sitio en
# https://www.google.com/recaptcha/admin con los dominios de este servidor.
# RECAPTCHA_SITE_KEY es publica (va al frontend); RECAPTCHA_SECRET_KEY es privada
# (va solo al backend, nunca se expone).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Documentacion interactiva de la API (/docs, /redoc). Dejar en false en cualquier
# ambiente publico.
ENABLE_DOCS=false
