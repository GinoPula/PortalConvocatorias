DATABASE_URL=postgresql+psycopg2://postgres:CAMBIAR@localhost:5432/portal_mvcs
SECRET_KEY=cambiar-esta-clave-en-produccion
CORS_ORIGINS=http://localhost:5173
OPENAI_API_KEY=
STORAGE_PATH=./storage
# Documentacion interactiva de la API (/docs, /redoc). Cerrada por defecto; en local
# la puedes prender con ENABLE_DOCS=true para explorar los endpoints comodamente.
ENABLE_DOCS=false

# Google reCAPTCHA v3 en el login (sin casilla, evalua en segundo plano con un
# puntaje). Esta es la clave de prueba oficial de Google v2 (siempre pasa la
# verificacion, sin puntaje) - sirve para desarrollo local porque el backend
# no exige puntaje cuando Google no lo devuelve. En el servidor real hay que
# usar la clave v3 real del sitio registrado en
# https://www.google.com/recaptcha/admin (RECAPTCHA_SECRET_KEY es privada).
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_MIN_SCORE=0.5
